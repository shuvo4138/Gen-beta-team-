{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "setup": {
      "commands": [
        "apt-get update && apt-get install -y chromium chromium-driver --no-install-recommends"
      ]
    },
    "install": {
      "commands": [
        "pip install -r requirements.txt"
      ]
    }
  },
  "deploy": {
    "startCommand": "python file_bot.py"
  }
}
